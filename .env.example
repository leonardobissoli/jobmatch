# Copy this file to .env. Never commit the resulting .env file.

LOG_LEVEL=INFO

# Optional: required only when MiniMax is selected in the interface.
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_MODEL=MiniMax-M2.7
MINIMAX_TIMEOUT_SECONDS=180

# Ollama and LM Studio run on the host machine. Docker connectivity is
# configured automatically by docker-compose.yml.
LOCAL_LLM_TIMEOUT_SECONDS=300
